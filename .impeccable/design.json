  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one strong action on a screen: ink, not color.",
      "html": "<button class=\"ds-btn ds-btn--primary\">Save plan</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;height:var(--control-height,36px);padding:0 16px;border:1px solid transparent;border-radius:var(--radius-sm,8px);font:600 0.8125rem/1 var(--font-sans);cursor:pointer;transition:background-color 120ms cubic-bezier(.2,0,0,1),opacity 120ms cubic-bezier(.2,0,0,1)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--color-accent,#3e3cb4);outline-offset:2px}.ds-btn--primary{background:var(--color-ink,#121b2c);color:var(--color-ink-fg,#fff);box-shadow:var(--shadow-1)}.ds-btn--primary:hover{opacity:.88}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Second actions next to a primary.",
      "html": "<button class=\"ds-btn2\">Import file</button>",
      "css": ".ds-btn2{display:inline-flex;align-items:center;height:36px;padding:0 16px;border:1px solid var(--color-border-strong,#cbd1db);border-radius:var(--radius-sm,8px);background:var(--color-surface,#fff);color:var(--color-fg,#0d1626);font:600 0.8125rem/1 var(--font-sans);box-shadow:var(--shadow-1);cursor:pointer;transition:background-color 120ms cubic-bezier(.2,0,0,1)}.ds-btn2:hover{background:var(--color-surface-2,#eef0f4)}.ds-btn2:focus-visible{outline:2px solid var(--color-accent,#3e3cb4);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Tertiary actions in card headers and toolbars.",
      "html": "<button class=\"ds-btn3\">Show all</button>",
      "css": ".ds-btn3{display:inline-flex;align-items:center;height:36px;padding:0 16px;border:1px solid transparent;border-radius:var(--radius-sm,8px);background:transparent;color:var(--color-muted,#566173);font:600 0.8125rem/1 var(--font-sans);cursor:pointer;transition:background-color 120ms,color 120ms}.ds-btn3:hover{background:var(--color-surface-2,#eef0f4);color:var(--color-fg,#0d1626)}.ds-btn3:focus-visible{outline:2px solid var(--color-accent,#3e3cb4);outline-offset:2px}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "A sunken well with an indigo ring on focus.",
      "html": "<input class=\"ds-input\" placeholder=\"Search instruments\">",
      "css": ".ds-input{width:100%;height:44px;padding:0 12px;border:1px solid var(--color-border,#e3e6ec);border-radius:var(--radius-sm,8px);background:var(--color-surface-2,#eef0f4);color:var(--color-fg,#0d1626);font:400 0.9375rem/1.5 var(--font-sans);transition:border-color 120ms,background-color 120ms}.ds-input::placeholder{color:var(--color-faint,#5a6578)}.ds-input:hover{border-color:var(--color-border-strong,#cbd1db)}.ds-input:focus-visible{outline:2px solid var(--color-accent,#3e3cb4);outline-offset:0;border-color:var(--color-accent,#3e3cb4);background:var(--color-surface,#fff)}"
    },
    {
      "name": "Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Statuses and tags: always an icon or a word next to the tone.",
      "html": "<span class=\"ds-chip\">Live · 14:32 ET</span> <span class=\"ds-chip ds-chip--pos\">▲ +1.2%</span> <span class=\"ds-chip ds-chip--neg\">▼ −0.4%</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:4px;height:28px;padding:0 12px;border:1px solid var(--color-border,#e3e6ec);border-radius:999px;background:var(--color-surface-2,#eef0f4);color:var(--color-fg,#0d1626);font:500 0.75rem/1 var(--font-sans);font-variant-numeric:tabular-nums}.ds-chip--pos{background:var(--color-pos-soft,rgba(42,97,129,.1));border-color:transparent;color:var(--color-pos,#2a6181)}.ds-chip--neg{background:var(--color-neg-soft,rgba(116,33,12,.09));border-color:transparent;color:var(--color-neg,#74210c)}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented-track",
      "description": "Ranges, sub-tabs and the EUR | USD toggle.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg__opt ds-seg__opt--on\">EUR</button><button class=\"ds-seg__opt\">USD</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:2px;border:1px solid var(--color-border,#e3e6ec);border-radius:var(--radius-md,12px);background:var(--color-surface-2,#eef0f4)}.ds-seg__opt{min-width:36px;height:30px;padding:0 12px;border:0;border-radius:9px;background:transparent;color:var(--color-muted,#566173);font:600 0.8125rem/1 var(--font-sans);cursor:pointer;transition:background-color 120ms,color 120ms}.ds-seg__opt:hover{color:var(--color-fg,#0d1626)}.ds-seg__opt--on{background:var(--color-surface,#fff);color:var(--color-fg,#0d1626);box-shadow:var(--shadow-1)}.ds-seg__opt:focus-visible{outline:2px solid var(--color-accent,#3e3cb4);outline-offset:2px}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "The section container: title, quiet meta note, body.",
      "html": "<section class=\"ds-card\"><header class=\"ds-card__head\"><h3 class=\"ds-card__title\">Holdings</h3><span class=\"ds-card__meta\">Prices as of 16:00 ET</span></header><div class=\"ds-card__body\"><span class=\"ds-card__label\">Total value</span><span class=\"ds-card__fig\">€184,320.55</span></div></section>",
      "css": ".ds-card{background:var(--color-surface,#fff);border:1px solid var(--color-border,#e3e6ec);border-radius:var(--radius-lg,16px);box-shadow:var(--shadow-1);transition:box-shadow 200ms,border-color 200ms}.ds-card:hover{border-color:var(--color-border-strong,#cbd1db);box-shadow:var(--shadow-hover)}.ds-card__head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding:20px 24px 0}.ds-card__title{margin:0;font:600 1.0625rem/1.2 var(--font-sans);letter-spacing:-0.015em;color:var(--color-fg,#0d1626)}.ds-card__meta{color:var(--color-muted,#566173);font:400 0.75rem/1.2 var(--font-sans)}.ds-card__body{display:grid;gap:4px;padding:16px 24px 20px}.ds-card__label{color:var(--color-muted,#566173);font:500 0.75rem/1.2 var(--font-sans)}.ds-card__fig{color:var(--color-fg,#0d1626);font:500 1.625rem/1.2 var(--font-sans);letter-spacing:-0.02em;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Navigation Item",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Spine rows; the open page is a lit row with an indigo edge bar.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav__link ds-nav__link--on\" href=\"#\">Overview</a><a class=\"ds-nav__link\" href=\"#\">Holdings</a><a class=\"ds-nav__link\" href=\"#\">Periods</a></nav>",
      "css": ".ds-nav{display:grid;gap:2px;width:220px;padding:8px;border-radius:var(--radius-lg,16px);background:#f5f7fa}.ds-nav__link{position:relative;display:flex;align-items:center;height:32px;padding:0 12px;border-radius:var(--radius-sm,8px);color:var(--color-muted,#566173);font:500 0.8125rem/1 var(--font-sans);text-decoration:none;transition:background-color 120ms,color 120ms}.ds-nav__link:hover{background:#e4e8f0;color:var(--color-fg,#0d1626)}.ds-nav__link:focus-visible{outline:2px solid var(--color-accent,#3e3cb4);outline-offset:2px}.ds-nav__link--on{background:var(--color-surface,#fff);box-shadow:var(--shadow-1);color:var(--color-fg,#0d1626);font-weight:600}.ds-nav__link--on::before{content:'';position:absolute;left:-8px;top:8px;bottom:8px;width:3px;border-radius:3px;background:var(--color-accent,#3e3cb4)}"
    }
  ],
  "narrative": {
    "northStar": "The Neo-Private Bank",
    "overview": "The calm of a private-bank statement, built with the polish of the best neobank and neobroker apps. It should feel technical and current without ever feeling busy: generous, even spacing; soft layered surfaces with restrained depth; large, confident figures; one restrained accent; motion so quiet you notice it only when it's missing. The numbers are the loud part. Everything around them steps back.\n\nTwo signatures carry the identity. The **spine** is the grouped navigation with the portfolio's value at its head: a quiet light spine in the light theme, deep navy ink in the dark. The **stage** is a page's one subject on a single lit surface a step above the cards: on Overview, the portfolio value in an oversized serif with today's move and the chart. Each page has at most one stage, and everything else is a quieter panel.\n\nThe dark theme is a theme of its own, not an inverted light one: a deep blue-black canvas lit from above by two faint glows, surfaces that step up in blue-grey, and light hairlines in place of heavier shadows. Confirmed anti-references: a trading terminal (dense, flashing, red/green), a crypto or neon look (glowing gradients, gamified finance), and a hobby or template admin dashboard (default kit cards, walls of charts).",
    "keyCharacteristics": [
      "Figures first: tabular numerals everywhere, one oversized serif figure per page at most.",
      "Ink, not color, for action; one indigo accent for selection, focus and links only.",
      "Protan-safe values: gains in blue, losses in orange, never red/green, never color alone.",
      "One stage per page, one rhythm per page, one figure per screen.",
      "EUR and USD share one shape: switching currency never moves anything.",
      "Phone and desktop are the same product at two densities."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Indigo means \"selected, focused or clickable\". It never carries a value, a status or a series.",
        "section": "colors"
      },
      {
        "name": "The Ink-Not-Color Rule",
        "body": "The primary action is ink on canvas. Colored buttons are reserved for destructive actions (rust, soft fill).",
        "section": "colors"
      },
      {
        "name": "The Protan Rule",
        "body": "Gains are blue, losses are orange. Any two colors that appear together with different meanings go into the CVD pair list, and no meaning rides on color alone: statuses carry an icon or a word, secondary series are dashed.",
        "section": "colors"
      },
      {
        "name": "The Serif Marks the Subject Rule",
        "body": "Serif for titles and the single lead figure only. Never in tables, tiles or controls.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every figure is `tabular-nums`, right-aligned in tables.",
        "section": "typography"
      },
      {
        "name": "The Quiet Label Rule",
        "body": "Labels are sentence case, medium weight, muted; the figure under them is the loud part. Only tickers stay in capitals, because they are names.",
        "section": "typography"
      },
      {
        "name": "The One Stage Rule",
        "body": "A page has at most one stage: its single subject, a step above the cards.",
        "section": "layout"
      },
      {
        "name": "The One Shape Rule",
        "body": "EUR and USD have one shape. Fitted figures keep a fixed line box, currency-only lines are reserved or held invisibly, and rows keep their line count. A currency switch never moves anything.",
        "section": "layout"
      },
      {
        "name": "The Once-Per-Screen Rule",
        "body": "A figure appears once per screen. Charts get a second axis only from 720px of chart width; the right gutter is reserved either way, so the plot never resizes.",
        "section": "layout"
      },
      {
        "name": "The Lift-Without-Moving Rule",
        "body": "Hovering a clickable surface changes its border and shadow only. Nothing moves, except a 1px press on buttons.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** take every color, size, space and radius from a `var(--…)` token in `tokens.scss`, with BEM class names.",
      "**Do** use tabular numerals for every figure and right-align numbers in tables.",
      "**Do** add every new co-displayed color pair to `tokens.cvd.test.ts`, and pair every status color with an icon or a word.",
      "**Do** dash every secondary chart series.",
      "**Do** keep motion quiet: 120ms for hover and press, 200ms for state changes and sheets, 320ms for the one page fade; standard easing `cubic-bezier(0.2, 0, 0, 1)`; turn all of it off under reduced motion.",
      "**Do** show freshness on every data view and use skeletons, never a spinner over a blank page.",
      "**Do** keep the information on phones; change the density, not the content."
    ],
    "donts": [
      "**Don't** use red/green for gains and losses, or let color alone carry a meaning.",
      "**Don't** use the indigo accent as a value, status or series color.",
      "**Don't** set the serif in tables, tiles or controls, or put more than one oversized figure on a page.",
      "**Don't** let a EUR/USD switch move, resize or reflow anything.",
      "**Don't** build a trading-terminal look: dense flashing tickers, red/green walls, cramped grids.",
      "**Don't** use a crypto or neon look: glowing gradients, saturated color fields, gamified finance styling.",
      "**Don't** ship a hobby or template-admin dashboard: default kit cards, walls of charts, uneven gaps or a lone tile on its own row.",
      "**Don't** bounce, slide cards in one by one, or move surfaces on hover."
    ]
  }
}
