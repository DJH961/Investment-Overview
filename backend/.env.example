# Settings for the v6 server (all prefixed INV_DASHBOARD_).
# Copy to the server as /home/daniel/app.env, fill in, then `chmod 600` it.
# NEVER commit the real file. Values below are placeholders.
# Generate a secret with:  openssl rand -hex 32

# --- Secrets ----------------------------------------------------------------
# SQLCipher key for the database. LOSS = DATA LOSS: keep a copy in your
# password manager. Do not change it on an existing database.
INV_DASHBOARD_DB_PASSPHRASE=changeme
# Signs session cookies. Required in server mode. Rotating logs everyone out.
# Optional market-data fallback token (Tiingo). Leave empty to disable.
INV_DASHBOARD_TIINGO_TOKEN=

# --- Server mode (set by the Dockerfile; shown for completeness) --------------
INV_DASHBOARD_SERVER_MODE=true
INV_DASHBOARD_ENCRYPT_SYNCED_TIERS=true
INV_DASHBOARD_SCHEDULER_ENABLED=true
INV_DASHBOARD_LOG_LEVEL=INFO

# --- Sessions and login -------------------------------------------------------
INV_DASHBOARD_SESSION_IDLE_MINUTES=30
INV_DASHBOARD_SESSION_MAX_AGE_DAYS=30
# Keep true behind HTTPS (Caddy). Only false for plain-http local dev.
INV_DASHBOARD_COOKIE_SECURE=true
INV_DASHBOARD_LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- Passkeys (WebAuthn): must match the public address -----------------------
INV_DASHBOARD_WEBAUTHN_RP_ID=investments.daniel-henke.de
INV_DASHBOARD_WEBAUTHN_RP_NAME=Investment Overview
INV_DASHBOARD_WEBAUTHN_ORIGIN=https://investments.daniel-henke.de

# --- Local development only (not used in the container) -----------------------
# INV_DASHBOARD_DB_PATH=./dev.sqlite
# INV_DASHBOARD_FRONTEND_DIST=../frontend/dist
# INV_DASHBOARD_DEV_CORS_ORIGINS=["http://localhost:5173"]
