# Settings for the v6 server (all prefixed INV_DASHBOARD_).
# Copy to the server as /opt/investments/app.env, fill in, then `chmod 600` it.
# NEVER commit the real file. Values below are placeholders.
# Generate a secret with:  openssl rand -hex 32

# --- Secrets ----------------------------------------------------------------
# SQLCipher key for the database. LOSS = DATA LOSS: keep a copy in your
# password manager. Do not change it on an existing database.
INV_DASHBOARD_DB_PASSPHRASE=changeme
# Passphrase that seals the backup snapshots (AES-256-GCM). A restore needs it, so
# keep a copy in your password manager. If left empty, the DB passphrase is used.
INV_DASHBOARD_BACKUP_PASSPHRASE=changeme-too
# Optional bearer token for scripts (header "Authorization: Bearer <token>").
# At least 32 characters; leave empty to switch token access off.
# Generate with:  openssl rand -hex 32
# INV_DASHBOARD_API_TOKEN=
# Optional market-data fallback token (Tiingo). Leave empty to disable.
# It can also be entered in the app (Settings -> Providers, write-only); a value
# set in the app wins over this one.
INV_DASHBOARD_TIINGO_TOKEN=

# --- Server mode (set by the Dockerfile; shown for completeness) --------------
INV_DASHBOARD_SERVER_MODE=true
INV_DASHBOARD_ENCRYPT_SYNCED_TIERS=true
INV_DASHBOARD_SCHEDULER_ENABLED=true
# Start-up log level; Settings -> System -> Log detail overrides it live.
INV_DASHBOARD_LOG_LEVEL=INFO

# --- Sessions and login -------------------------------------------------------
INV_DASHBOARD_SESSION_IDLE_MINUTES=30
INV_DASHBOARD_SESSION_MAX_AGE_DAYS=30
# Keep true behind HTTPS (Caddy). Only false for plain-http local dev.
INV_DASHBOARD_COOKIE_SECURE=true
INV_DASHBOARD_LOGIN_RATE_LIMIT_PER_MINUTE=5
# Password checks running at once (argon2 uses ~64 MiB each); more get 503.
INV_DASHBOARD_LOGIN_MAX_CONCURRENT_VERIFIES=2
# Passkey add/remove and backup download need a sign-in this recent (minutes).
INV_DASHBOARD_FRESH_SESSION_MINUTES=10

# --- Request limits and proxy ---------------------------------------------------
# Largest request body in bytes (default 64 KiB); imports allow the upload cap.
INV_DASHBOARD_MAX_BODY_BYTES=65536
INV_DASHBOARD_MAX_UPLOAD_BODY_BYTES=11534336
# Connections uvicorn serves at once before answering 503.
INV_DASHBOARD_LIMIT_CONCURRENCY=64
# Proxies trusted for X-Forwarded-For (comma-separated IPs/CIDRs): Caddy's address.
# deploy/docker-compose.yml pins Caddy to 172.29.84.2 and sets this for the app itself.
INV_DASHBOARD_FORWARDED_ALLOW_IPS=127.0.0.1
# /docs, /redoc and /openapi.json are off in server mode unless this is true.
INV_DASHBOARD_EXPOSE_API_DOCS=false

# --- Passkeys (WebAuthn): must match the public address -----------------------
INV_DASHBOARD_WEBAUTHN_RP_ID=investments.daniel-henke.de
INV_DASHBOARD_WEBAUTHN_RP_NAME=Investment Overview
INV_DASHBOARD_WEBAUTHN_ORIGIN=https://investments.daniel-henke.de

# --- Paths and listener (the Dockerfile sets what the container needs) ---------
# Listen address and port of the API server.
# INV_DASHBOARD_HOST=0.0.0.0
# INV_DASHBOARD_PORT=8080
# Folder for the rotating log files; default: a logs/ folder beside the database.
# INV_DASHBOARD_LOG_DIR=
# Size of one log file in bytes before it rolls over (default 2 MB).
# INV_DASHBOARD_LOG_MAX_BYTES=2000000
# How many rolled-over log files to keep next to the active one.
# INV_DASHBOARD_LOG_BACKUP_COUNT=5
# Separate ledger / config / cache database files (split-tier layout). Normally
# unset: the server uses the single DB_PATH file for all tiers.
# INV_DASHBOARD_LEDGER_PATH=
# INV_DASHBOARD_CONFIG_PATH=
# INV_DASHBOARD_CACHE_PATH=

# Seconds the end-of-day job waits after the closing bell before it settles the
# day's closes (the UI shows "Closing..." meanwhile; default 60).
# INV_DASHBOARD_EOD_GRACE_SECONDS=60
# Minutes after the bell for one quiet re-pull of the day's closes (0 = off).
# INV_DASHBOARD_CLOSE_REPULL_MINUTES=5

# --- Local development only (not used in the container) -----------------------
# INV_DASHBOARD_DB_PATH=./dev.sqlite
# INV_DASHBOARD_FRONTEND_DIST=../frontend/dist
# INV_DASHBOARD_DEV_CORS_ORIGINS=["http://localhost:5173"]
