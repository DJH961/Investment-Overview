# Compose-level variables (read by `docker compose` from deploy/.env).
# NOT secrets. App secrets belong in the env file named below.

# Image tag to run (a release version or a commit sha); "latest" if unset.
APP_TAG=latest

# Absolute path of the app's env file on the server (holds secrets, chmod 600).
# Template: backend/.env.example
APP_ENV_FILE=/opt/investments/app.env
